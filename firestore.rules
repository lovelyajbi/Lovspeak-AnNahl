rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A seat is granted only by the server-side capacity gate. It is never
    // writable by a learner, so client code cannot manufacture access.
    function hasAccessSeat() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/accessSeats/$(request.auth.uid));
    }

    function isOwnerWithAccess(userId) {
      return isOwner(userId) && hasAccessSeat();
    }

    function isBootstrapAdmin() {
      return isAuthenticated() && (request.auth.token.email == "lovelyatrial@gmail.com" || request.auth.token.adminMaster == true);
    }

    function isAdmin() {
      // Admin privileges are also seats: an admin UID cannot bypass the
      // account cap merely because an adminAccess document exists.
      return hasAccessSeat() && (isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid)));
    }

    // Master Settings (Activation Code)
    match /settings/master {
      // Activation is verified server-side; never expose this document to users.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwnerWithAccess(userId) || isAdmin();
      allow create: if isOwnerWithAccess(userId) || isAdmin();
      allow update: if isOwnerWithAccess(userId) || isAdmin();
      
      // Subcollections (Diary, Vocab, Activity, Settings)
      match /{allSubcollections=**} {
        allow read, write: if isOwnerWithAccess(userId) || isAdmin();
      }
    }

    // Seat records are server-managed. Admins can audit them, but learners
    // cannot read, create, update, or delete their own seat.
    match /accessSeats/{userId} {
      allow read: if isAdmin();
      // Firebase Admin SDK writes bypass rules; browser clients never may.
      allow write: if false;
    }

    match /adminAccess/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (hasAccessSeat() && resource.data.recipientId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (hasAccessSeat() && resource.data.recipientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']));
      allow delete: if isAdmin() || (hasAccessSeat() && resource.data.recipientId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if isAdmin() || (isAuthenticated() &&
          hasAccessSeat() &&
          get(/databases/$(database)/documents/feedback/$(feedbackId)).data.recipientId == request.auth.uid);
        allow create: if isAdmin() || (isAuthenticated() &&
          hasAccessSeat() &&
          get(/databases/$(database)/documents/feedback/$(feedbackId)).data.recipientId == request.auth.uid &&
          request.resource.data.authorId == request.auth.uid);
        allow update: if isAdmin();
        allow delete: if isAdmin() || (hasAccessSeat() && resource.data.authorId == request.auth.uid);
      }
    }

    // Admin-created assignments are private to each recipient. The admin owns
    // the definition; a learner may only acknowledge/read their own copy.
    match /assignments/{assignmentId} {
      allow read, write: if isAdmin();
    }

    match /userAssignments/{userId}/items/{assignmentId} {
      allow read: if isOwnerWithAccess(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwnerWithAccess(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt is string);
      allow delete: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }

    match /userNotifications/{userId}/items/{notificationId} {
      allow read: if isOwnerWithAccess(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwnerWithAccess(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt is string);
      allow delete: if isOwnerWithAccess(userId) || isAdmin();
    }
  }
}
